# ── Copy to .env and fill in. NEVER commit .env. ─────────────────────────────
NODE_ENV=production

# Public URL of the platform (used in alert links). With a domain: https://scm.opptra.com
PUBLIC_URL=http://YOUR_STATIC_IP

# Caddy site address: ":80" while on bare IP, "scm.opptra.com" once DNS exists (auto-HTTPS).
SITE_ADDRESS=:80

# Postgres password for the compose-internal database (generate: openssl rand -hex 24)
POSTGRES_PASSWORD=

# ── Unicommerce (the ONE whitelisted bot account) ────────────────────────────
UC_BASE_URL=https://oppdoor.unicommerce.co.in
UC_USER=
UC_PASS=
# Bridge until scripted login: optionally seed a manually captured JSESSIONID here,
# or paste it in the web app's Admin tab after boot (preferred — no restart needed).
UC_JSESSIONID_OVERRIDE=
UC_DEFAULT_FACILITY=
UC_KEEPALIVE_MINUTES=4

# ── Human auth (Google SSO) ──────────────────────────────────────────────────
# OAuth 2.0 Web client ID from GCP Console → APIs & Services → Credentials.
# Authorized JavaScript origins must include PUBLIC_URL.
GOOGLE_CLIENT_ID=
ALLOWED_DOMAIN=opptra.com
# Comma-separated bootstrap admins (they get the admin role on first login):
ADMIN_EMAILS=vishwas.pandey@opptra.com
# Generate: openssl rand -hex 32
JWT_SECRET=
SESSION_TTL_HOURS=12

# ── Alerting (optional but recommended) ──────────────────────────────────────
SLACK_WEBHOOK_URL=
LOG_LEVEL=info
