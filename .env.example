# ── Copy to .env and fill in. NEVER commit .env. ─────────────────────────────
NODE_ENV=production

# Public URL of the platform (used in alert links). With a domain: https://scm.opptra.com
PUBLIC_URL=http://YOUR_STATIC_IP

# Caddy site address: ":80" while on bare IP, "scm.opptra.com" once DNS exists (auto-HTTPS).
SITE_ADDRESS=:80

# Postgres password for the compose-internal database (generate: openssl rand -hex 24)
POSTGRES_PASSWORD=

# ── Unicommerce (the ONE whitelisted bot account) ────────────────────────────
UC_BASE_URL=https://oppdoor.unicommerce.co.in
UC_USER=
UC_PASS=
# Bridge until scripted login: optionally seed a manually captured JSESSIONID here,
# or paste it in the web app's Admin tab after boot (preferred — no restart needed).
UC_JSESSIONID_OVERRIDE=
UC_DEFAULT_FACILITY=
UC_KEEPALIVE_MINUTES=4
# Global throttle so we never trip Unicommerce's rate limit (applies to ALL automations).
UC_MAX_RPS=4
UC_BURST=8

# ── Inward / Outward / Full-cycle (proven defaults from the Apps Script app) ──
UC_VENDOR_CODE=
UC_SHELF_CODE=DEFAULT
UC_CURRENCY=INR
UC_TAX_CODE=
# ADJUST = bearer-only stock add (no session needed). GRN_PUTAWAY = full internal route.
UC_INWARD_MODE=ADJUST
UC_GRN_TRAIL=true
UC_OUTWARD_CHANNEL=CUSTOM
UC_OUTWARD_SHIP_METHOD=STD

# ── Human auth (Google SSO) ──────────────────────────────────────────────────
# OAuth 2.0 Web client ID from GCP Console → APIs & Services → Credentials.
# Authorized JavaScript origins must include PUBLIC_URL.
GOOGLE_CLIENT_ID=
# Client secret of the SAME OAuth client - only needed for the one-time "Connect Google
# Workspace" admin flow (Gmail/Sheets via OAuth consent, the no-service-account fallback).
GOOGLE_OAUTH_CLIENT_SECRET=
ALLOWED_DOMAIN=opptra.com
# Comma-separated bootstrap admins (they get the admin role on first login):
ADMIN_EMAILS=vishwas.pandey@opptra.com
# Generate: openssl rand -hex 32
JWT_SECRET=
SESSION_TTL_HOURS=12

# ── Alerting (optional but recommended) ──────────────────────────────────────
SLACK_WEBHOOK_URL=
LOG_LEVEL=info

# ── Google Workspace (packing-mail / sheet-update / reports-digest) ───────────
# One-time: create a service account, enable domain-wide delegation for the scopes
# (gmail.compose, gmail.send, drive.readonly, spreadsheets) in Workspace admin, impersonate
# a Workspace user. GOOGLE_SA_EMAIL is the keyless path (no exported key - the VM's own
# attached identity signs assertions via IAM Credentials; needs roles/iam.serviceAccountTokenCreator
# on that service account). Only set GOOGLE_SA_KEY_JSON if key export isn't blocked by org policy.
GOOGLE_SA_EMAIL=opptra-scm-workspace@opptra-applications.iam.gserviceaccount.com
GOOGLE_SA_KEY_JSON=
GOOGLE_DELEGATED_USER=sc.automations@opptra.com
MASTER_SHEET_ID=

# Packing mail: warehouse → To / CC / Finance recipients (share with GOOGLE_DELEGATED_USER)
WAREHOUSE_EMAIL_SHEET_ID=
WAREHOUSE_EMAIL_TAB=

# Sheet update (A1) first-fill: Waypoint's own Neon Postgres, read-only. Preferred over
# the WAYPOINT_BASE_URL CSV export below - direct SQL, no session/cookie to keep alive.
WAYPOINT_DB_URL=postgresql://user:pass@host/neondb?sslmode=require
WAYPOINT_BASE_URL=https://opptra-so-tracker.vercel.app
WAYPOINT_COOKIE=

# ── Vinculum (Home Centre sync) ──────────────────────────────────────────────
VINCULUM_BASE_URL=
VINCULUM_USER=
VINCULUM_PASS=
