# ── Copy to .env and fill in. NEVER commit .env. ─────────────────────────────
NODE_ENV=production

# Public URL of the platform (used in alert links). With a domain: https://scm.opptra.com
PUBLIC_URL=http://YOUR_STATIC_IP

# Caddy site address: ":80" while on bare IP, "scm.opptra.com" once DNS exists (auto-HTTPS).
SITE_ADDRESS=:80

# Postgres password for the compose-internal database (generate: openssl rand -hex 24)
POSTGRES_PASSWORD=

# ── Unicommerce (per-instance bots — no cross-tenant fallback) ───────────────
# Intended automation identities (Google/Outlook DLs unless noted):
#   India → sc.automations@opptra.com  (real mailbox; India UC only)
#   UAE   → scuae.automations@opptra.com
#   KSA   → scksa.automations@opptra.com
#   FZE   → scfze.automations@opptra.com  (planned; no UC host/instance wired yet)
# Policy: India = sc.automations only. Never reuse India for UAE/KSA/staging/FZE.
#
# IMPORTANT — DL alone cannot OAuth/login to Unicommerce. UC needs a real UC user.
# Options: (a) create a UC user whose username is the DL email + password, or
# (b) Admin-paste JSESSIONID from a real user on that tenant while *_USER is set
# to the DL (labeling / status-mail identity). Session ≠ mailbox login.
UC_BASE_URL=https://oppdoor.unicommerce.co.in
UC_USER=
UC_PASS=
# Dedicated GCC bots (aliases; HC_UC_UAE_* / HC_UC_KSA_* also accepted):
# Example identities (leave empty until UC user or session paste is ready):
# UC_UAE_USER=scuae.automations@opptra.com
# UC_KSA_USER=scksa.automations@opptra.com
UC_UAE_USER=
UC_UAE_PASS=
UC_KSA_USER=
UC_KSA_PASS=
# FZE (scfze.automations@opptra.com): TBD — confirm UC company code / host before
# adding UC_*_FZE keys. Do not invent a unicommerce hostname.
# Bridge until scripted login: optionally seed a manually captured JSESSIONID here,
# or paste it in the web app's Admin tab after boot (preferred — no restart needed).
# UC_JSESSIONID_OVERRIDE seeds the india vault row only.
UC_JSESSIONID_OVERRIDE=
UC_DEFAULT_FACILITY=
UC_KEEPALIVE_MINUTES=4
# Global throttle so we never trip Unicommerce's rate limit (applies to ALL automations).
UC_MAX_RPS=4
UC_BURST=8

# ── Inward / Outward / Full-cycle (proven defaults from the Apps Script app) ──
UC_VENDOR_CODE=
UC_SHELF_CODE=DEFAULT
UC_CURRENCY=INR
UC_TAX_CODE=
# ADJUST = bearer-only stock add (no session needed). GRN_PUTAWAY = full internal route.
UC_INWARD_MODE=ADJUST
UC_GRN_TRAIL=true
UC_OUTWARD_CHANNEL=CUSTOM
UC_OUTWARD_SHIP_METHOD=STD

# ── Human auth (Google SSO) ──────────────────────────────────────────────────
# OAuth 2.0 Web client ID from GCP Console → APIs & Services → Credentials.
# Authorized JavaScript origins must include PUBLIC_URL.
GOOGLE_CLIENT_ID=
# Client secret of the SAME OAuth client - only needed for the one-time "Connect Google
# Workspace" admin flow (Gmail/Sheets via OAuth consent, the no-service-account fallback).
GOOGLE_OAUTH_CLIENT_SECRET=
ALLOWED_DOMAIN=opptra.com
# Comma-separated bootstrap admins (they get the admin role on first login):
ADMIN_EMAILS=vishwas.pandey@opptra.com,ratikanta@opptra.com
# Generate: openssl rand -hex 32
JWT_SECRET=
SESSION_TTL_HOURS=12

# ── Alerting (optional but recommended) ──────────────────────────────────────
SLACK_WEBHOOK_URL=
LOG_LEVEL=info

# ── Cursor / Slack ops agent (machine auth, no Google SSO) ───────────────────
# Generate: openssl rand -hex 32
# Same value → VM .env AND Cursor Automation secrets as OPS_AGENT_TOKEN.
# Enables GET /api/ops/summary (recent failures + week stats). Never paste in Slack.
OPS_AGENT_TOKEN=

# ── Google Workspace (packing-mail / sheet-update / reports-digest) ───────────
# One-time: create a service account, enable domain-wide delegation for the scopes
# (gmail.compose, gmail.send, drive.readonly, spreadsheets) in Workspace admin, impersonate
# a Workspace user. GOOGLE_SA_EMAIL is the keyless path (no exported key - the VM's own
# attached identity signs assertions via IAM Credentials; needs roles/iam.serviceAccountTokenCreator
# on that service account). Only set GOOGLE_SA_KEY_JSON if key export isn't blocked by org policy.
GOOGLE_SA_EMAIL=opptra-scm-workspace@opptra-applications.iam.gserviceaccount.com
GOOGLE_SA_KEY_JSON=
GOOGLE_DELEGATED_USER=sc.automations@opptra.com
MASTER_SHEET_ID=

# Packing mail: warehouse → To / CC / Finance recipients (share with GOOGLE_DELEGATED_USER)
WAREHOUSE_EMAIL_SHEET_ID=
WAREHOUSE_EMAIL_TAB=

# Sheet update (A1) first-fill: Waypoint's own Neon Postgres, read-only. Preferred over
# the WAYPOINT_BASE_URL CSV export below - direct SQL, no session/cookie to keep alive.
WAYPOINT_DB_URL=postgresql://user:pass@host/neondb?sslmode=require
WAYPOINT_BASE_URL=https://opptra-so-tracker.vercel.app
WAYPOINT_COOKIE=

# ── Vinculum / Home Centre (GCC) ─────────────────────────────────────────────
VINCULUM_BASE_URL=https://landmarkgroup.vinsupplier.com/eRetailWeb
VINCULUM_USER=
VINCULUM_PASS=
# Optional: HAR-captured fulfill steps JSON (confirm/invoice/ready/ship/label)
VINCULUM_FULFILL_ACTIONS_JSON=
# Status / owner alerts today → personal owners. Eventually prefer regional DLs as To:
#   UAE HC → scuae.automations@opptra.com | KSA → scksa.automations@opptra.com
# Do not flip production recipients until ops agrees.
HC_OWNER_EMAIL=ratikanta@opptra.com
HC_SYNC_MINUTES=0
HC_LIVE=false
HC_DRY_RUN=true
HC_ORDERS_UC_TARGET=staging
# Orders → staging UC (personal/staging bot ONLY — never India UC_USER)
HC_UC_STAGING_BASE_URL=https://oppdoorstg.unicommerce.com
HC_UC_STAGING_USER=
HC_UC_STAGING_PASS=
HC_UC_STAGING_FACILITY=oppdoorstg
HC_UC_STAGING_CHANNEL=CUSTOM
HC_UC_STAGING_CUSTOMER=OPPB2B01
HC_STAGING_SKU_FALLBACK=optest
# Inventory ← UAE UC (dedicated UAE bot; or UC_UAE_*). Upload only when HC_LIVE=true
# Identity: scuae.automations@opptra.com (DL — see UC login note above)
HC_UC_UAE_BASE_URL=https://opptrauae.unicommerce.com
# HC_UC_UAE_USER=scuae.automations@opptra.com
HC_UC_UAE_USER=
HC_UC_UAE_PASS=
# Session/vault facility (may be OPP_RFS_FZ_UAE)
HC_UC_UAE_FACILITY=OPP_RFS_FZ_UAE
# Inventory snapshot facility — OppDoor HC Tower stock is at opptrauae
HC_UC_UAE_INV_FACILITY=opptrauae
HC_UC_UAE_CHANNEL=Home Centre B2C
HC_UC_UAE_CUSTOMER=
# KSA UC (dedicated KSA bot; or UC_KSA_*) — company code opptraksa
# Identity: scksa.automations@opptra.com (DL — see UC login note above)
HC_UC_KSA_BASE_URL=https://opptraksa.unicommerce.com
# HC_UC_KSA_USER=scksa.automations@opptra.com
HC_UC_KSA_USER=
HC_UC_KSA_PASS=
HC_UC_KSA_FACILITY=
# Vinculum vendorCode for seller SKU download (defaults to VINCULUM_USER, e.g. 2424675)
HC_VINCULUM_VENDOR_CODE=
# Seller Code column on import xlsx; empty = use sellerCode from downloaded list
HC_SELLER_CODE_UAE=
HC_SELLER_CODE_KSA=90
HC_UC_CHANNEL=CUSTOM
HC_UC_SHIP_METHOD=STD
HC_UC_CURRENCY=AED
HC_UC_FACILITY=
# Optional overrides only — identity on seller skuCode (T80358…) is enough; do not invent LAND* maps
HC_SKU_MAP_JSON=
SCM_DEFAULT_REGION=india

# ── Agent chat LLM (optional; empty → tool-router mode) ──────────────────────
# AGENT_LLM_PROVIDER=auto|openai|anthropic|none
AGENT_LLM_PROVIDER=auto
AGENT_LLM_API_KEY=
AGENT_LLM_BASE_URL=
AGENT_LLM_MODEL=
# Aliases (optional):
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# ── Amazon SP-API (optional; Agent Amazon card stays Coming soon until enabled) ─
AMAZON_SP_CLIENT_ID=
AMAZON_SP_CLIENT_SECRET=
AMAZON_SP_REFRESH_TOKEN=
AMAZON_SP_MARKETPLACE_ID=A21TJRUUN4KGV
AMAZON_SP_ENDPOINT=https://sellingpartnerapi-eu.amazon.com

# ── Flipkart Seller API (optional; card Coming soon until enabled) ────────────
FLIPKART_APP_ID=
FLIPKART_APP_SECRET=
FLIPKART_ACCESS_TOKEN=
FLIPKART_API_BASE=https://api.flipkart.net/sellers

# ── 6th Street (GCC) — secrets on VM only; never commit values ────────────────
# VPN (40-client / Forti-style): connect before portal/OMS
STREET6_VPN_NAME=6thStreet-OMS
STREET6_VPN_HOST=10.61.1.11
STREET6_VPN_USER=
STREET6_VPN_PASS=
STREET6_PORTAL_URL=https://seller-portal.6thstreet.com/#/app
STREET6_PORTAL_USER=
STREET6_PORTAL_PASS=
STREET6_OMS_URL=https://apg-oms.prod.coc.ibmcloud.com/wsc/store/login.do
STREET6_OMS_HOME_URL=https://apg-oms.prod.coc.ibmcloud.com/wsc/ngstore/home.do?scFlag=Y
STREET6_OMS_USER=
STREET6_OMS_PASS=
# Pack/status mail To: today personal. Eventually UAE/KSA runs may use
# scuae.automations@opptra.com / scksa.automations@opptra.com (do not change live To yet).
STREET6_EMAIL_TO=daniyal@opptra.com
STREET6_OWNER_EMAIL=daniyal@opptra.com
# Inventory source UC instance (facility mapping unconfirmed → india default)
STREET6_UC_INSTANCE=india
STREET6_UC_FACILITY=
STREET6_LIVE=false
STREET6_DRY_RUN=true
# Combined 6th Street scheduled job (pack-email + inventory). 0 = manual only.
STREET6_SYNC_MINUTES=0
